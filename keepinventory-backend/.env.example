# Copia este archivo como .env y completa los valores (el .env no se sube a git).
# En producción estas variables se definen en el panel del hosting, no en un archivo.

# Obligatoria: contraseña de PostgreSQL
DB_PASSWORD=

# Opcionales (tienen valor por defecto para desarrollo en application.properties)
# DB_URL=jdbc:postgresql://localhost:5432/inventory_management
# DB_USERNAME=postgres
# JWT_SECRET=          (generar con: openssl rand -base64 32)
# CORS_ALLOWED_ORIGINS=http://localhost:4200
